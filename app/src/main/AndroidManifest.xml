            android:exported="false" />
        <activity
            android:name=".settings.FontSizesSettingsActivity" android:enableOnBackInvokedCallback="false"
            android:exported="false" />
        <activity
            android:name=".settings.FontSettingsActivity" android:enableOnBackInvokedCallback="false"
            android:exported="false" />
        <activity
            android:name=".settings.AnimationSettingsActivity" android:enableOnBackInvokedCallback="false"
            android:exported="false" />
        <activity
            android:name=".settings.HardwareKeysSettingsActivity" android:enableOnBackInvokedCallback="false"
            android:exported="false" />
        <activity
            android:name=".ui.AppLauncherActivity" android:enableOnBackInvokedCallback="false"
            android:exported="false" />
        <activity
