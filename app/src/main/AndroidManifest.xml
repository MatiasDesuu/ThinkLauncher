            android:configChanges="orientation|screenSize|keyboardHidden"
            android:theme="@style/AppTheme" />
        <activity
            android:name=".ui.ClockActivity" android:enableOnBackInvokedCallback="false"
            android:exported="false" />
        <activity
            android:name=".ui.AlarmActivity" android:enableOnBackInvokedCallback="false"
            android:exported="false"
            android:theme="@style/AlarmTheme"
            android:hardwareAccelerated="false"
            android:showWhenLocked="true"
            android:turnScreenOn="true"
            android:excludeFromRecents="true"
            android:launchMode="singleTop" />
        <service
            android:name=".services.AlarmForegroundService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="alarm" />
        </service>
        <receiver
            android:name=".receivers.AlarmReceiver"
            android:exported="false" />
