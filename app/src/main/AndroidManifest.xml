            android:exported="false" />
        <activity
            android:name=".settings.GestureSettingsActivity" android:enableOnBackInvokedCallback="false"
            android:exported="false" />
        <activity
            android:name=".settings.CustomGestureSettingsActivity" android:enableOnBackInvokedCallback="false"
            android:exported="false" />
        <activity
            android:name=".settings.AppBarSettingsActivity" android:enableOnBackInvokedCallback="false"
            android:exported="false" />
        <activity
            android:name=".settings.AppBarAppsActivity" android:enableOnBackInvokedCallback="false"
            android:exported="false" />
        <activity
            android:name=".settings.AppBarPositionActivity" android:enableOnBackInvokedCallback="false"
            android:exported="false" />
        <activity
            android:name=".settings.AppBarStyleActivity" android:enableOnBackInvokedCallback="false"
            android:exported="false" />
        <activity
            android:name=".settings.DockSettingsActivity" android:enableOnBackInvokedCallback="false"
            android:exported="false" />
        <activity
            android:name=".settings.MusicDockSettingsActivity" android:enableOnBackInvokedCallback="false"
            android:exported="false" />
        <activity
            android:name=".settings.MusicDockStyleActivity" android:enableOnBackInvokedCallback="false"
            android:exported="false" />
        <activity
            android:name=".settings.DocksSettingsActivity" android:enableOnBackInvokedCallback="false"
            android:exported="false" />
        <activity
            android:name=".settings.RecordGestureActivity" android:enableOnBackInvokedCallback="false"
            android:exported="false" />
        <activity
            android:name=".settings.DisplaySettingsActivity" android:enableOnBackInvokedCallback="false"
            android:exported="false" />
        <activity
            android:name=".settings.ThemeSettingsActivity" android:enableOnBackInvokedCallback="false"
            android:exported="false" />
        <activity
            android:name=".settings.TimeSettingsActivity" android:enableOnBackInvokedCallback="false"
            android:exported="false" />
        <activity
            android:name=".settings.DateSettingsActivity" android:enableOnBackInvokedCallback="false"
            android:exported="false" />
        <activity
            android:name=".settings.SettingsButtonSettingsActivity" android:enableOnBackInvokedCallback="false"
            android:exported="false" />
        <activity
            android:name=".settings.SearchButtonSettingsActivity" android:enableOnBackInvokedCallback="false"
            android:exported="false" />
