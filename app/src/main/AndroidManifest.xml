<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.EXPAND_STATUS_BAR" />
    <uses-permission android:name="android.permission.REQUEST_DELETE_PACKAGES" />
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" />
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" />
    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES" />
    <uses-permission android:name="android.permission.READ_MEDIA_VIDEO" />
    <uses-permission android:name="android.permission.READ_CALENDAR" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
    <uses-permission android:name="android.permission.USE_EXACT_ALARM" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.USE_FULL_SCREEN_INTENT" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.MANAGE_EXTERNAL_STORAGE"
        tools:ignore="ScopedStorage" />
    <uses-permission
        android:name="android.permission.QUERY_ALL_PACKAGES"
        tools:ignore="QueryAllPackagesPermission" />
    <uses-permission android:name="android.permission.GET_INSTALLED_APPS" />

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:theme="@style/AppTheme">
        <service
            android:name=".services.LockAccessibilityService"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE"
            android:exported="false">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/accessibility_service_config" />
        </service>
        <receiver
            android:name=".services.LockDeviceAdminReceiver"
            android:permission="android.permission.BIND_DEVICE_ADMIN"
            android:exported="true">
            <intent-filter>
                <action android:name="android.app.action.DEVICE_ADMIN_ENABLED" />
            </intent-filter>
            <meta-data
                android:name="android.app.device_admin"
                android:resource="@xml/device_admin" />
        </receiver>
        <service
            android:name=".services.MusicNotificationListenerService"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE"
            android:exported="false">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:excludeFromRecents="true"
            android:taskAffinity=""
            android:stateNotNeeded="true"
            android:clearTaskOnLaunch="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
                <category android:name="android.intent.category.HOME" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>
        <activity
            android:name=".settings.SettingsActivity"
            android:exported="false" />
        <activity
            android:name=".settings.HomeScreenSettingsActivity"
            android:exported="false" />
        <activity
            android:name=".settings.AppearanceSettingsActivity"
            android:exported="false" />
        <activity
            android:name=".settings.FontsSettingsActivity"
            android:exported="false" />
        <activity
            android:name=".settings.ControlsSettingsActivity"
            android:exported="false" />
        <activity
            android:name=".settings.AppLauncherSettingsActivity"
            android:exported="false" />
        <activity
            android:name=".settings.SystemSettingsActivity"
            android:exported="false" />
        <activity
            android:name=".settings.GestureSettingsActivity"
            android:exported="false" />
        <activity
            android:name=".settings.CustomGestureSettingsActivity"
            android:exported="false" />
        <activity
            android:name=".settings.AppBarSettingsActivity"
            android:exported="false" />
        <activity
            android:name=".settings.AppBarAppsActivity"
            android:exported="false" />
        <activity
            android:name=".settings.AppBarPositionActivity"
            android:exported="false" />
        <activity
            android:name=".settings.AppBarStyleActivity"
            android:exported="false" />
        <activity
            android:name=".settings.DockSettingsActivity"
            android:exported="false" />
        <activity
            android:name=".settings.MusicDockSettingsActivity"
            android:exported="false" />
        <activity
            android:name=".settings.MusicDockStyleActivity"
            android:exported="false" />
        <activity
            android:name=".settings.DocksSettingsActivity"
            android:exported="false" />
        <activity
            android:name=".settings.RecordGestureActivity"
            android:exported="false" />
        <activity
            android:name=".settings.DisplaySettingsActivity"
            android:exported="false" />
        <activity
            android:name=".settings.ThemeSettingsActivity"
            android:exported="false" />
        <activity
            android:name=".settings.TimeSettingsActivity"
            android:exported="false" />
        <activity
            android:name=".settings.DateSettingsActivity"
            android:exported="false" />
        <activity
            android:name=".settings.SettingsButtonSettingsActivity"
            android:exported="false" />
        <activity
            android:name=".settings.SearchButtonSettingsActivity"
            android:exported="false" />
        <activity
            android:name=".settings.OpacityBlurEffectsActivity"
            android:exported="false" />
        <activity
            android:name=".settings.HomeSettingsActivity"
            android:exported="false" />
        <activity
            android:name=".settings.IconSettingsActivity"
            android:exported="false" />
        <activity
            android:name=".settings.TextSettingsActivity"
            android:exported="false" />
        <activity
            android:name=".settings.WallpaperSettingsActivity"
            android:exported="false" />
        <activity
            android:name=".settings.HomeScreenPaddingActivity"
            android:exported="false" />
        <activity
            android:name=".settings.FontSizesSettingsActivity"
            android:exported="false" />
        <activity
            android:name=".settings.FontSettingsActivity"
            android:exported="false" />
        <activity
            android:name=".settings.AnimationSettingsActivity"
            android:exported="false" />
        <activity
            android:name=".settings.HardwareKeysSettingsActivity"
            android:exported="false" />
        <activity
            android:name=".ui.AppLauncherActivity"
            android:exported="false" />
        <activity
            android:name=".ui.HideAppsActivity"
            android:exported="false" />
        <activity
            android:name=".ui.AppSelectorActivity"
            android:exported="false" />
        <activity
            android:name=".ui.KOReaderHistoryActivity"
            android:exported="false" />
        <activity
            android:name=".ui.CalendarActivity"
            android:exported="false" />
        <activity
            android:name=".ui.FolderActivity"
            android:exported="false" />
        <activity
            android:name=".ui.GalleryActivity"
            android:exported="false" />
        <activity
            android:name=".ui.GalleryViewerActivity"
            android:exported="false" />
        <activity
            android:name=".ui.VideoFullscreenActivity"
            android:exported="false"
            android:screenOrientation="sensorLandscape"
            android:configChanges="orientation|screenSize|keyboardHidden"
            android:theme="@style/AppTheme" />
        <activity
            android:name=".ui.ClockActivity"
            android:exported="false" />
        <activity
            android:name=".ui.AlarmActivity"
            android:exported="false"
            android:theme="@style/AlarmTheme"
            android:hardwareAccelerated="false"
            android:showWhenLocked="true"
            android:turnScreenOn="true"
            android:excludeFromRecents="true"
            android:launchMode="singleTop" />
        <service
            android:name=".services.AlarmForegroundService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="alarm" />
        </service>
        <receiver
            android:name=".receivers.AlarmReceiver"
            android:exported="false" />
        <receiver
            android:name=".receivers.AlarmDismissReceiver"
            android:exported="false" />
        <receiver
            android:name=".receivers.AlarmSnoozeReceiver"
            android:exported="false" />
        <receiver
            android:name=".receivers.CancelSnoozeReceiver"
            android:exported="false" />
        <receiver
            android:name=".receivers.TimerReceiver"
            android:exported="false" />
        <receiver
            android:name=".receivers.TimerCancelReceiver"
            android:exported="false" />
        <receiver
            android:name=".receivers.BootReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.LOCKED_BOOT_COMPLETED" />
                <action android:name="android.intent.action.QUICKBOOT_POWERON" />
            </intent-filter>
        </receiver>
    </application>

</manifest>
