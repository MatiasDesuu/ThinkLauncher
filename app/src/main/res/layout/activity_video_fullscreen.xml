<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root_layout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/background_color">

    <VideoView
        android:id="@+id/fullscreen_video_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_gravity="center" />

    <ImageView
        android:id="@+id/fullscreen_play"
        android:layout_width="64dp"
        android:layout_height="64dp"
        android:layout_gravity="center"
        android:src="@drawable/ic_media_play"
        android:padding="8dp"
        android:visibility="gone" />

    <LinearLayout
        android:id="@+id/fullscreen_controls"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_gravity="bottom"
        android:layout_marginLeft="8dp"
        android:layout_marginRight="8dp"
        android:layout_marginBottom="8dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingLeft="8dp"
        android:paddingRight="8dp">

        <TextView
            android:id="@+id/fullscreen_current_time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="0:00"
            android:textSize="12sp"
            android:textColor="?attr/text_color"
            android:minWidth="40dp"
            android:gravity="center"
            android:textAlignment="center" />

        <FrameLayout
            android:id="@+id/fullscreen_seek_container"
            android:layout_width="0dp"
            android:layout_height="16dp"
            android:layout_weight="1"
            android:layout_marginLeft="8dp"
            android:layout_marginRight="8dp"
            android:clickable="true"
            android:focusable="false">

            <View
                android:id="@+id/fullscreen_progress"
                android:layout_width="0dp"
                android:layout_height="match_parent" />

        </FrameLayout>

        <TextView
            android:id="@+id/fullscreen_duration"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="0:00"
            android:textSize="12sp"
            android:textColor="?attr/text_color"
            android:minWidth="40dp"
            android:gravity="center"
            android:textAlignment="center" />

        <ImageView
            android:id="@+id/fullscreen_exit_button"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_marginLeft="8dp"
            android:src="@drawable/fullscreen_exit"
            android:padding="6dp"
            android:contentDescription="Exit fullscreen" />

    </LinearLayout>

</FrameLayout>
