<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:minWidth="280dp"
    android:orientation="vertical"
    android:animateLayoutChanges="false"
    android:paddingLeft="16dp"
    android:paddingTop="16dp"
    android:paddingRight="16dp"
    android:paddingBottom="16dp">

    <LinearLayout
        android:id="@+id/main_options_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:animateLayoutChanges="false"
        android:orientation="vertical">

        <TextView
            android:id="@+id/filter_button"
            style="@style/DialogButton"
            android:text="Filter: All"
            android:layout_width="match_parent" />

        <LinearLayout
            android:id="@+id/sort_button"
            style="@style/DialogButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/sort_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Sort: Date"
                android:textColor="?attr/text_color"
                android:textSize="18sp"
                android:gravity="center" />

            <ImageView
                android:id="@+id/sort_arrow"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_marginStart="8dp"
                android:src="@drawable/back_arrow"
                android:tint="?attr/text_color" />

        </LinearLayout>

        <TextView
            android:id="@+id/trash_button"
            style="@style/DialogButton"
            android:text="Trash"
            android:layout_width="match_parent"
            android:layout_marginTop="8dp" />

        <TextView
            android:id="@+id/favorites_button"
            style="@style/DialogButton"
            android:text="Favorites"
            android:layout_width="match_parent"
            android:layout_marginTop="8dp" />

        <TextView
            android:id="@+id/hidden_button"
            style="@style/DialogButton"
            android:text="Hidden"
            android:layout_width="match_parent"
            android:layout_marginTop="8dp" />

        <TextView
            android:id="@+id/empty_trash_button"
            style="@style/DialogButton"
            android:text="Empty trash"
            android:layout_width="match_parent"
            android:layout_marginTop="8dp"
            android:visibility="gone" />

        <TextView
            android:id="@+id/more_options_button"
            style="@style/DialogButton"
            android:text="More Options"
            android:layout_width="match_parent"
            android:layout_marginTop="8dp" />

    </LinearLayout>

</LinearLayout>
