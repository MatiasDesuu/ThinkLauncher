<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root_layout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/background_color"
    android:orientation="vertical">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <ImageView
            android:id="@+id/back_button"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:src="@drawable/back_arrow"
            android:layout_alignParentLeft="true"
            android:layout_centerVertical="true"
            android:padding="12dp"
            android:tint="?attr/text_color" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/music_note"
                android:layout_marginEnd="8dp"
                android:tint="?attr/text_color" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:text="Music Dock Style"
                android:textColor="?attr/text_color"
                android:textSize="24sp"
                android:textStyle="bold"
                android:gravity="center" />

        </LinearLayout>

    </RelativeLayout>

    <View
        android:id="@+id/divider"
        android:layout_width="match_parent"
        android:layout_height="2dp"
        android:background="?attr/text_color" />

    <FrameLayout
        android:id="@+id/settings_container"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <ScrollView android:scrollbars="none"
            android:id="@+id/settings_scroll_view"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:overScrollMode="never">

            <LinearLayout
                android:id="@+id/settings_items_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

            <LinearLayout
                android:id="@+id/icon_background_layout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_margin="16dp">

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@drawable/app_icons"
                    android:layout_marginEnd="8dp"
                    android:tint="?attr/text_color" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Icon Background:"
                    android:textColor="?attr/text_color"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <include layout="@layout/plus_minus_layout"
                    android:id="@+id/icon_background_container" />

            </LinearLayout>

            <LinearLayout
                android:id="@+id/icon_shape_layout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_margin="16dp">

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@drawable/adjust_position"
                    android:layout_marginEnd="8dp"
                    android:tint="?attr/text_color" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Icon Shape:"
                    android:textColor="?attr/text_color"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <include layout="@layout/plus_minus_layout"
                    android:id="@+id/icon_shape_container" />

            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_margin="16dp">

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@drawable/style"
                    android:layout_marginEnd="8dp"
                    android:tint="?attr/text_color" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Icon Effect:"
                    android:textColor="?attr/text_color"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <include layout="@layout/plus_minus_layout"
                    android:id="@+id/icon_effect_container" />

            </LinearLayout>

            <LinearLayout
                android:id="@+id/icon_effect_color_layout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_margin="16dp">

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@drawable/columns"
                    android:layout_marginEnd="8dp"
                    android:tint="?attr/text_color" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Icon Effect Color:"
                    android:textColor="?attr/text_color"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <include layout="@layout/plus_minus_layout"
                    android:id="@+id/icon_effect_color_container" />

            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_margin="16dp">

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@drawable/border"
                    android:layout_marginEnd="8dp"
                    android:tint="?attr/text_color" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Border Color:"
                    android:textColor="?attr/text_color"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <include layout="@layout/plus_minus_layout"
                    android:id="@+id/border_color_container" />

            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_margin="16dp">

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@drawable/background_border"
                    android:layout_marginEnd="8dp"
                    android:tint="?attr/text_color" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Background Color:"
                    android:textColor="?attr/text_color"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <include layout="@layout/plus_minus_layout"
                    android:id="@+id/background_color_container" />

            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_margin="16dp">

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@drawable/text_size"
                    android:layout_marginEnd="8dp"
                    android:tint="?attr/text_color" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Text Color:"
                    android:textColor="?attr/text_color"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <include layout="@layout/plus_minus_layout"
                    android:id="@+id/text_color_container" />

            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_margin="16dp">

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@drawable/style"
                    android:layout_marginEnd="8dp"
                    android:tint="?attr/text_color" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Text Effect:"
                    android:textColor="?attr/text_color"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <include layout="@layout/plus_minus_layout"
                    android:id="@+id/text_effect_container" />

            </LinearLayout>

            <LinearLayout
                android:id="@+id/text_effect_color_layout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_margin="16dp">

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@drawable/colors"
                    android:layout_marginEnd="8dp"
                    android:tint="?attr/text_color" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Text Effect Color:"
                    android:textColor="?attr/text_color"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <include layout="@layout/plus_minus_layout"
                    android:id="@+id/text_effect_color_container" />

            </LinearLayout>

        </LinearLayout>

        </ScrollView>

    </FrameLayout>

    <include layout="@layout/pagination_bottom_bar" />

</LinearLayout>
